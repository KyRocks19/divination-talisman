{
  "expo": {
    "name": "Divination Talisman",
    "slug": "divination-talisman",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID unlocks your readings when you turn on the lock."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.divinationstation.talisman",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID unlocks your readings when you turn on the lock."
        }
      ],
      "./plugins/with-release-signing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for the oracle cards you make.",
          "cameraPermission": "Take photos of the oracle cards you make.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Link your oracle cards to photos in your library, without keeping a second copy.",
          "savePhotosPermission": "Save the card photos you take to your library, so the card can link to them.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-image"
    ],
    "scheme": "divination-talisman",
    "backgroundColor": "#0d0d1a"
  }
}
